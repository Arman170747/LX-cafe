<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Lexus Service Token</title>

<style>

*{
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    margin:0;
    background:#111;
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
}


.container{

    width:420px;
    background:#ffffff;
    padding:35px;
    border-radius:15px;

    box-shadow:
    0 10px 30px rgba(0,0,0,0.5);

}


.logo{

    text-align:center;
    font-size:34px;
    letter-spacing:5px;
    font-weight:bold;
    margin-bottom:10px;

}


.subtitle{

    text-align:center;
    color:#555;
    margin-bottom:30px;

}



label{

    display:block;
    margin-bottom:8px;
    font-weight:bold;

}



input{

    width:100%;
    padding:15px;
    font-size:18px;

    border:1px solid #ccc;
    border-radius:8px;

    margin-bottom:20px;

}



.type-box{

    display:flex;
    gap:15px;
    margin-bottom:25px;

}


.type-card{

    flex:1;

    border:2px solid #ddd;

    padding:15px;

    border-radius:10px;

    text-align:center;

    cursor:pointer;

}


.type-card:hover{

    border-color:#000;

}


.type-card input{

    width:auto;
    margin:0 5px 0 0;

}


button{


    width:100%;
    padding:16px;

    background:#000;

    color:white;

    border:none;

    border-radius:10px;

    font-size:18px;

    cursor:pointer;

}



button:hover{

    background:#333;

}



.result{


    margin-top:25px;

    text-align:center;

    display:none;

}



.token{


    font-size:45px;

    font-weight:bold;

    margin:10px;

}



.info{


    background:#f5f5f5;

    padding:15px;

    border-radius:10px;

}



.footer{

    text-align:center;

    margin-top:20px;

    color:#777;

    font-size:12px;

}


</style>


</head>


<body>


<div class="container">


<div class="logo">
LEXUS
</div>


<div class="subtitle">
Service Appointment Token
</div>



<label>
Vehicle Plate Number
</label>


<input 
id="plateNumber"
placeholder="Example: DXB12345"
autocomplete="off">



<label>
Customer Type
</label>


<div class="type-box">


<label class="type-card">

<input 
type="radio"
name="customerType"
value="Appointment">

Appointment

</label>



<label class="type-card">

<input 
type="radio"
name="customerType"
value="Walk-in"
checked>

Walk-in

</label>


</div>




<button onclick="generateToken()">

Generate Token

</button>




<div class="result" id="resultBox">


<div>
Your Token
</div>


<div class="token" id="tokenNumber">

L001

</div>


<div class="info">

Plate:
<span id="showPlate"></span>

<br><br>

Type:
<span id="showType"></span>

</div>


</div>




<div class="footer">

Lexus Service Center Queue System

</div>



</div>





<script>


let tokenCounter = 1;



function generateToken(){


let plate =
document.getElementById("plateNumber").value.trim();



if(plate==""){

alert("Please enter vehicle plate number");

return;

}



let type =
document.querySelector(
'input[name="customerType"]:checked'
).value;



let token =
"L" + 
String(tokenCounter).padStart(3,'0');



tokenCounter++;



document.getElementById(
"tokenNumber"
).innerHTML = token;



document.getElementById(
"showPlate"
).innerHTML = plate;



document.getElementById(
"showType"
).innerHTML = type;



document.getElementById(
"resultBox"
).style.display="block";



/*
Later this function will send data
to Google Sheet using Apps Script

Example:

google.script.run
.saveToken(
token,
plate,
type
);

*/


document.getElementById(
"plateNumber"
).value="";


}



</script>


</body>

</html>
